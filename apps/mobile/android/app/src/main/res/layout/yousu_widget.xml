<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/ledger" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CDE6DF" android:textSize="12sp" android:maxLines="1" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本期支出" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="12dp" />
<TextView android:id="@+id/expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" />
<TextView android:id="@+id/remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CDE6DF" android:textSize="11sp" android:layout_marginTop="6dp" />
<TextView android:id="@+id/period" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CDE6DF" android:textSize="9sp" />
<TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CDE6DF" android:textSize="9sp" android:layout_marginTop="6dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="＋ 记一笔" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="10dp" />
</LinearLayout>
